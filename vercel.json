{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      // the Vike build output includes both `server` and `client`
      // directories; static HTML lives under `dist/client`. point
      // Vercel at that subfolder so it can serve the generated files
      // directly.
      "config": { "distDir": "dist/client" }
    }
  ]
}
